# LLM配置
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 数据库配置
DATABASE_URL=sqlite:///./data/audit.db

# 安全配置
ENABLE_SECURITY_GUARDRAIL=true
ENABLE_INPUT_SANITIZER=true
ENABLE_OUTPUT_VALIDATOR=true
ENABLE_SANDBOX=true
ENABLE_PERMISSION_SERVICE=true
LOG_LEVEL=INFO

# 服务器配置
# 默认仅监听本机；如需内网/公网访问，改为 0.0.0.0 并开启认证（见下方 AUTH_*）
HOST=127.0.0.1
PORT=8000
RELOAD=false

# CORS配置（逗号分隔的源列表；* 表示允许所有源，与 allow_credentials=True 不兼容）
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 基础登录认证（可选，默认关闭；开启后需同时设置 AUTH_USERNAME 与 AUTH_PASSWORD）
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=

# 密钥加密存储：用于加密落库的模型 API 密钥（Fernet）。
# 留空则自动生成并持久化到 data/.secret_key（同一机器重启后可解密）。
# 多实例部署请显式设置相同 SECRET_KEY，否则其他实例无法解密密钥。
SECRET_KEY=

# 会话配置
MAX_CONVERSATION_HISTORY=50
SESSION_TIMEOUT=3600
